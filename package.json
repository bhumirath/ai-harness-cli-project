{
  "name": "@ai-harness/cli",
  "version": "0.2.9",
  "description": "AI Harness — local coding agent and always-on agent CLI",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "harness": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/sync-version.mjs --check && tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "dev": "node --experimental-strip-types src/bin.ts",
    "start": "node dist/bin.js",
    "lint": "oxlint --deny-warnings src test && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:api": "node scripts/gen-api.mjs",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "prepack": "pnpm build",
    "verify:package": "node scripts/verify-package.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "test:native:linux": "pnpm build && node scripts/test-native-linux.mjs",
    "test:native:powershell": "pnpm build && node scripts/test-native-linux.mjs --powershell",
    "test:native:powershell:windows": "node scripts/test-native-powershell-windows.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "commander": "^15.1.0",
    "openapi-fetch": "^0.17.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.6",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.93.0",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@9.15.9",
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bhumirath/ai-harness-cli-project.git"
  }
}
